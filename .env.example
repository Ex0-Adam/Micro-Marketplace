# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# The Prisma datasource uses these two names directly:
#   POSTGRES_PRISMA_URL       -> runtime connection (pooled is fine)
#   POSTGRES_URL_NON_POOLING  -> direct connection, used by `prisma db push` / migrations
# On Vercel + Supabase integration both are injected automatically.
# For a plain/self-hosted Postgres set both to the same connection string
# (add ?pgbouncer=true to POSTGRES_PRISMA_URL only if you go through a pooler).
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/postgres?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/postgres?schema=public"

# ============================================
# Application URLs
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# Security & Authentication
# ============================================
# REQUIRED: session cookies are HMAC-signed with this secret.
# Generate: openssl rand -hex 32
SESSION_SECRET=""

# REQUIRED only for initial admin creation. Remove after setup is complete.
# Generate: openssl rand -hex 32
INITIAL_ADMIN_SETUP_TOKEN=""

# CORS allowlist for cross-origin API clients (exact origins, comma-separated).
# No wildcard on purpose. Leave empty to disable cross-origin access.
# THOTH instances that fetch this catalogue must be listed here.
ALLOWED_ORIGINS=""

# ============================================
# Media Storage (Optional)
# ============================================
# STORAGE_DRIVER = local | s3 | r2
STORAGE_DRIVER="local"
# Public URL base for locally stored uploads
LOCAL_UPLOAD_URL_BASE="/uploads"

# S3-compatible storage (when STORAGE_DRIVER=s3|r2)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
S3_PUBLIC_URL_BASE=""
